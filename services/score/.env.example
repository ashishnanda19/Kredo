# Copy to .env for running the API or worker outside Docker (make api / make worker). Dev-only values.
SCORE_DATABASE_URL=postgresql+psycopg://kredo:kredo@localhost:55433/kredo_score
SCORE_REDIS_URL=redis://localhost:56380/0
SCORE_HMAC_KEYS={"demo": {"secret": "dev-only-demo-secret-0000000000000000", "sources": ["demo_controls", "simulator"]}, "nbfc": {"secret": "dev-only-nbfc-secret-0000000000000000", "sources": ["nbfc"]}, "bff": {"secret": "dev-only-bff-secret-00000000000000000", "sources": ["demo_controls"]}}
FEATURE_MANDATES=false
SCORE_OPS_JWT_SECRET=dev-only-ops-jwt-secret-000000000000000
# dev only: lets the web app's demo controls create fake students (POST /v1/demo/presets/{name})
SCORE_DEMO_PRESETS=true
