# Demo flags. NEXT_PUBLIC_DEMO_CONTROLS is ON in development and OFF in a production build unless it is set to true.
# Leave it unset (or false) on the deployed site. Set it to true here for local use. NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_DEMO_CONTROLS=true
NEXT_PUBLIC_PHASE2_CREDIT_PROFILE=true

# Score service (server-only, never NEXT_PUBLIC). Leave SCORE_API_URL unset to keep the mock demo.
# SCORE_API_URL=http://localhost:8000
# SCORE_API_KEY_ID=bff
# SCORE_API_SECRET=dev-only-bff-secret-00000000000000000
# SCORE_DEMO_USER_ID=   # optional: a fixed student id until a demo preset sets one
# SCORE_OPS_JWT_SECRET=dev-only-ops-jwt-secret-000000000000000   # ops risk console; must match the service
